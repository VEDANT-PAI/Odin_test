ODIN_CHAT_LLM_URL=http://host.docker.internal:11434
ODIN_CHAT_LLM_MODEL=qwen2.5:3b
ODIN_CHAT_LLM_TIMEOUT=90
ODIN_CHAT_LLM_BEARER_TOKEN=
